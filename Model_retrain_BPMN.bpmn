<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_RetrainLanes"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_RetrainLanes" name="Retraining Cycle with Lanes" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Monitoring" name="Система мониторинга">
        <bpmn:flowNodeRef>Start_Trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPSI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PSI</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ML" name="ML-инженер / автоматика">
        <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Retrain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareMetrics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Metrics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lawyer" name="Юрист (human-in-the-loop)">
        <bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Deploy" name="Деплой / откат">
        <bpmn:flowNodeRef>Task_Deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rollback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Trigger" name="Cron / триггер дрифта">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckPSI" name="Проверка PSI">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PSI" name="PSI > 15%?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Critical</bpmn:outgoing>
      <bpmn:outgoing>Flow_Moderate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CollectData" name="Сбор данных (RusLawOD)">
      <bpmn:incoming>Flow_Critical</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Retrain" name="Обучение (переиндексация)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CompareMetrics" name="Сравнение метрик (AUC, F1)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Metrics" name="AUC > 0.85 и F1 > 0.80?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoDeploy</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManualReview" name="Ручная валидация 10 ответов">
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="Одобрено?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Deploy" name="Деплой новой версии">
      <bpmn:incoming>Flow_AutoDeploy</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Rollback" name="Откат к предыдущей версии">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifySuccess" name="Уведомление в Telegram: успех">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyRollback" name="Уведомление в Telegram: откат">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Success" name="Модель в продакшене">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rollback" name="Старая модель активна">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Trigger" targetRef="Task_CheckPSI" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckPSI" targetRef="Gateway_PSI" />
    <bpmn:sequenceFlow id="Flow_Critical" name="Да (>15%)" sourceRef="Gateway_PSI" targetRef="Task_CollectData" />
    <bpmn:sequenceFlow id="Flow_Moderate" name="Нет (5–15%)" sourceRef="Gateway_PSI" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CollectData" targetRef="Task_Retrain" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Retrain" targetRef="Task_CompareMetrics" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CompareMetrics" targetRef="Gateway_Metrics" />
    <bpmn:sequenceFlow id="Flow_AutoDeploy" name="Да" sourceRef="Gateway_Metrics" targetRef="Task_Deploy" />
    <bpmn:sequenceFlow id="Flow_Manual" name="Нет" sourceRef="Gateway_Metrics" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ManualReview" targetRef="Gateway_Approve" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Да" sourceRef="Gateway_Approve" targetRef="Task_Deploy" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Нет" sourceRef="Gateway_Approve" targetRef="Task_Rollback" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Deploy" targetRef="Task_NotifySuccess" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Rollback" targetRef="Task_NotifyRollback" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_NotifySuccess" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyRollback" targetRef="End_Rollback" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_RetrainLanes">
      <bpmndi:BPMNShape id="Lane_Monitoring_di" bpmnElement="Lane_Monitoring" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ML_di" bpmnElement="Lane_ML" isHorizontal="true">
        <dc:Bounds x="160" y="210" width="1520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lawyer_di" bpmnElement="Lane_Lawyer" isHorizontal="true">
        <dc:Bounds x="160" y="340" width="1520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Deploy_di" bpmnElement="Lane_Deploy" isHorizontal="true">
        <dc:Bounds x="160" y="470" width="1520" height="130" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Trigger_di" bpmnElement="Start_Trigger">
        <dc:Bounds x="200" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPSI_di" bpmnElement="Task_CheckPSI">
        <dc:Bounds x="280" y="98" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PSI_di" bpmnElement="Gateway_PSI" isMarkerVisible="true">
        <dc:Bounds x="470" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CollectData_di" bpmnElement="Task_CollectData">
        <dc:Bounds x="570" y="230" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Retrain_di" bpmnElement="Task_Retrain">
        <dc:Bounds x="750" y="230" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompareMetrics_di" bpmnElement="Task_CompareMetrics">
        <dc:Bounds x="930" y="230" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Metrics_di" bpmnElement="Gateway_Metrics" isMarkerVisible="true">
        <dc:Bounds x="1130" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ManualReview_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="930" y="360" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approve_di" bpmnElement="Gateway_Approve" isMarkerVisible="true">
        <dc:Bounds x="1130" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Deploy_di" bpmnElement="Task_Deploy">
        <dc:Bounds x="1250" y="490" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rollback_di" bpmnElement="Task_Rollback">
        <dc:Bounds x="1250" y="360" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifySuccess_di" bpmnElement="Task_NotifySuccess">
        <dc:Bounds x="1430" y="490" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRollback_di" bpmnElement="Task_NotifyRollback">
        <dc:Bounds x="1430" y="360" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success">
        <dc:Bounds x="1630" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rollback_di" bpmnElement="End_Rollback">
        <dc:Bounds x="1630" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="236" y="138" /><di:waypoint x="280" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="138" /><di:waypoint x="470" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Critical_di" bpmnElement="Flow_Critical">
        <di:waypoint x="495" y="163" /><di:waypoint x="495" y="270" /><di:waypoint x="570" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Moderate_di" bpmnElement="Flow_Moderate">
        <di:waypoint x="520" y="138" /><di:waypoint x="1010" y="138" /><di:waypoint x="1010" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="710" y="270" /><di:waypoint x="750" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="890" y="270" /><di:waypoint x="930" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1090" y="270" /><di:waypoint x="1130" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoDeploy_di" bpmnElement="Flow_AutoDeploy">
        <di:waypoint x="1155" y="295" /><di:waypoint x="1155" y="530" /><di:waypoint x="1250" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual">
        <di:waypoint x="1155" y="245" /><di:waypoint x="1155" y="400" /><di:waypoint x="1090" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1090" y="400" /><di:waypoint x="1130" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="1180" y="400" /><di:waypoint x="1320" y="400" /><di:waypoint x="1320" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="1155" y="425" /><di:waypoint x="1155" y="400" /><di:waypoint x="1250" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1390" y="530" /><di:waypoint x="1430" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1390" y="400" /><di:waypoint x="1430" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1590" y="530" /><di:waypoint x="1630" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1590" y="400" /><di:waypoint x="1630" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>